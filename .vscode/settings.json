{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-shell-escape",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=./tmp",
        "%DOC%"
      ]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-shell-escape",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=./tmp",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "--input-directory=./tmp",
        "--output-directory=./tmp",
        "%DOCFILE%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (xelatex + biber)",
      "tools": ["latexmk"]
    },
    {
      "name": "xelatex x2 (no bibliography)",
      "tools": ["xelatex", "xelatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (xelatex + biber)",
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.outDir": "./tmp",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "cSpell.words": [
    "biber",
    "biblatex",
    "ctex",
    "fontspec",
    "pygmentize",
    "thebibliography",
    "unicode-math",
    "xelatex"
  ]
}
