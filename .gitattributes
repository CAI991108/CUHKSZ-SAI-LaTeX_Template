# The repository stores every text file with LF line endings.
* text=auto

# Shell scripts must keep LF even when checked out on Windows, otherwise bash
# fails with "bad interpreter: /usr/bin/env: No such file or directory".
*.sh text eol=lf

# Batch files are executed by cmd.exe, which wants CRLF.
*.cmd text eol=crlf

# The vendored font licence is kept byte-identical to the upstream file.
fonts/LICENSE.txt text eol=lf

# Binary assets are never normalised.
*.otf binary
*.ttf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
